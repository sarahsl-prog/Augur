# syntax=docker/dockerfile:1.7
FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir uv
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen

COPY src/ ./src/
COPY prompts/ ./prompts/

ENV PORT=8080
EXPOSE 8080

CMD ["sh", "-c", "uv run streamlit run src/augur/dashboard/app.py --server.port=${PORT:-8080} --server.address=0.0.0.0 --server.headless=true"]
