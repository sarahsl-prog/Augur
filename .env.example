# Augur — example environment variables
# Copy to .env and fill in your values:
#   cp .env.example .env

# ── Phoenix Cloud ─────────────────────────────────────────────────────────────
# Get your API key from https://app.phoenix.arize.com → Settings → API Keys
# Tracing is on by default when this is set; omit to disable with a warning.
PHOENIX_API_KEY=

# Override Phoenix endpoint (default: https://app.phoenix.arize.com)
# PHOENIX_BASE_URL=https://app.phoenix.arize.com

# Set to 1 to explicitly disable OTel tracing (silences the missing-key warning).
# Already set to 1 by tests/conftest.py for unit tests.
# AUGUR_TRACING_DISABLED=1

# ── Google Cloud ──────────────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=augur-495810
GOOGLE_CLOUD_LOCATION=us-central1

# Path to a service account key JSON, if not using gcloud ADC.
# Leave unset when running with: gcloud auth application-default login
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json

# Override the GCP project used by Firestore + dashboard (default: augur-495810)
# GCP_PROJECT=augur-495810
